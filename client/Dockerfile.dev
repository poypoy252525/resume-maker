FROM node:22-alpine

WORKDIR /app

# Install dependencies first (leverage Docker caching)
# Only copy package.json (not package-lock.json) so npm resolves
# platform-specific native bindings correctly on Linux/musl.
COPY package.json ./
RUN npm install

# Copy source files
COPY . .

# Expose Vite dev port
EXPOSE 5173

# Run Vite dev server, bound to 0.0.0.0 for external docker mapping
CMD ["npm", "run", "dev", "--", "--host"]
