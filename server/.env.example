# ==============================================================================
# Django Development Environment Settings
# ==============================================================================

# Security
DEBUG=True
SECRET_KEY=django-insecure-resumaker-development-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,server

# Database Configuration (Docker container names)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery & Redis Configuration (Docker container names)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# App URL Settings
SITE_URL=http://localhost:5173

# Google Gemini API Config
# Provide your key here to enable AI resume reviews and paraphrasing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Settings (Optional in dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Google OAuth Configuration (Optional in dev)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
